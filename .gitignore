# Data stays local. Sources have their own licenses (Pollstar is copyrighted),
# and every file here can be rebuilt by running the ingest scripts.
data/**
!data/*/
!data/**/.gitkeep
# Hand-made labels can't be rebuilt by a script, so they are committed.
# They are original judgments about Wikipedia articles (CC BY-SA).
!data/labels/
!data/labels/**
*.db
*.sqlite
*.sqlite3

# Working notes (task list, lessons) stay local. The AI collaboration log
# in docs/ is the public record of how the project was directed.
tasks/

# Secrets and local config
.env
config.local.*

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# Power BI .pbix files embed the imported data. Commit the .pbit template
# (report layout and queries, no data) instead.
*.pbix

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
